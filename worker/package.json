{
  "name": "khu-dc-game-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ChatKHU 힌트 백엔드 + 게임 정적 파일 서빙 (Cloudflare Worker)",
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('../dist',{recursive:true})\"",
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p .",
    "tail": "wrangler tail --format json"
  },
  "devDependencies": {
    "wrangler": "4.151.2"
  }
}
