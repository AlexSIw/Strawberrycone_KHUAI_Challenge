    "@fontsource/noto-sans-kr": "5.3.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "galmuri": "2.40.3",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "2.15.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
